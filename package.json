{
  "name": "kiln-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Landing de Kiln (Astro + Tailwind + TypeScript) generada desde el archivo de Figma.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "tokens": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts --check",
    "lint:tokens": "tsx scripts/check-tokens.ts",
    "test:e2e": "playwright test --project=e2e",
    "visual": "tsx scripts/visual-diff.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "format": "prettier --write .",
    "fonts": "tsx scripts/build-fonts.ts",
    "sweep": "tsx scripts/responsive-sweep.ts",
    "test": "playwright test --project=e2e",
    "check": "npm run tokens:check && npm run lint:tokens && astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
