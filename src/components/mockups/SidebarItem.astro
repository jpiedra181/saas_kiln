---
/** Elemento de la barra lateral de la app (componente "Sidebar item" de Figma). */
import Icon, { type IconName } from '../ui/Icon.astro';

interface Props {
  icon: IconName;
  active?: boolean;
}

const { icon, active = false } = Astro.props;
---

<span
  class:list={[
    'flex w-full items-center gap-10 rounded-8 px-10 py-8',
    active ? 'bg-brand-subtle text-brand type-app-strong' : 'text-secondary type-app-body',
  ]}
>
  <Icon name={icon} class:list={['size-icon-md', active ? 'icon-brand' : 'icon-secondary']} />
  <span class="min-w-0 flex-1">
    <slot />
  </span>
</span>
