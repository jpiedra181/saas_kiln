---
/** Cómo funciona: tres pasos (sección "How it works" con "Step card" de Figma). */
import SectionHeader from '../ui/SectionHeader.astro';
import { sections } from '../../config/site';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const steps = [1, 2, 3] as const;
---

<section id={sections.how} class="bg-subtle px-page py-section-padding" aria-labelledby="how-title" data-section="how">
  <div class="mx-auto flex w-full max-w-hero-media flex-col items-center gap-section-gap">
    <SectionHeader id="how-title" eyebrow={t('how.eyebrow')} title={t('how.title')} subtitle={t('how.subtitle')} />
    <ol class="grid w-full gap-grid md:grid-cols-3">
      {steps.map((n) => (
        <li class="flex flex-col gap-24 rounded-24 border border-default bg-surface p-card" data-reveal>
          <span
            class="flex h-64 w-56 items-end justify-center rounded-t-full rounded-b-4 bg-brand-subtle pb-10"
            aria-hidden="true"
          >
            <span class="type-numeral text-brand">{t(`how.step-${n}.number`)}</span>
          </span>
          <div class="flex flex-col gap-8">
            <h3 class="type-h4 text-primary">{t(`how.step-${n}.title`)}</h3>
            <p class="type-body-md text-secondary">{t(`how.step-${n}.desc`)}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
